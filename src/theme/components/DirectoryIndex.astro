---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import themeConfig from 'virtual:starlight-theme-blog/config';
import {
	categoryMapFromCollection,
	getDirectoryChildren,
	titleForDirectory,
} from '../directory-index';
import { stripBasePath } from '../paths';

const base = import.meta.env.BASE_URL;
const pathname = stripBasePath(Astro.url.pathname, base).replace(/\/+$/, '') || '/';
const dirId = pathname.replace(/^\//, '');
const [docs, categoryEntries] = await Promise.all([
	getCollection('docs'),
	getCollection('docsCategories'),
]);
const categories = categoryMapFromCollection(categoryEntries);
const children = getDirectoryChildren(dirId, docs, categories, base);
const title = titleForDirectory(dirId, themeConfig.navs, categories);
---

<StarlightPage frontmatter={{ title, editUrl: false, prev: false, next: false }}>
	{
		children.length === 0 ? (
			<p>This directory has no pages yet.</p>
		) : (
			<div class="pagination-links dir-listing print:hidden">
				{children.map((child) => (
					<a href={child.href} rel="next">
						<Icon name="right-arrow" size="1.5rem" />
						<span>
							{child.type === 'dir' ? 'Browse' : 'Open'}
							<br />
							<span class="link-title">{child.label}</span>
						</span>
					</a>
				))}
			</div>
		)
	}
</StarlightPage>

<style>
	@layer starlight.core {
		.pagination-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
			gap: 1rem;
			margin-block: 1rem;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: end;
			gap: 0.5rem;
			width: 100%;
			flex-basis: calc(50% - 0.5rem);
			flex-grow: 1;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			padding: 1rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			box-shadow: var(--sl-shadow-md);
			overflow-wrap: anywhere;
			text-align: end;
			flex-direction: row-reverse;
		}

		a:hover {
			border-color: var(--sl-color-gray-2);
		}

		.link-title {
			color: var(--sl-color-white);
			font-size: var(--sl-text-2xl);
			line-height: var(--sl-line-height-headings);
		}

		a :global(svg) {
			flex-shrink: 0;
		}
	}
</style>
