---
import './carousel.css'
---

<div class="graph-carousel" data-graph-carousel>
	<div class="graph-carousel-container">
		<button
			type="button"
			class="graph-carousel-button"
			style="left: 10px"
			data-graph-carousel-prev
			aria-label="Previous"
		>
			<svg
				viewBox="0 0 1024 1024"
				version="1.1"
				xmlns="http://www.w3.org/2000/svg"
				width="100%"
				height="100%"
				aria-hidden="true"
			>
				<path
					d="M938.666667 1006.933333h-375.466667c-3.413333 0-10.24-3.413333-13.653333-3.413333l-477.866667-477.866667c-6.826667-6.826667-6.826667-17.066667 0-23.893333l477.866667-477.866667c3.413333-3.413333 6.826667-3.413333 13.653333-3.413333h375.466667c6.826667 0 13.653333 3.413333 17.066666 10.24s0 13.653333-3.413333 17.066667L484.693333 512l464.213334 464.213333c6.826667 6.826667 6.826667 13.653333 6.826666 20.48s-10.24 10.24-17.066666 10.24z m-368.64-34.133333h327.68L447.146667 525.653333c-6.826667-6.826667-6.826667-17.066667 0-23.893333L897.706667 51.2h-327.68L109.226667 512l460.8 460.8z"
				></path>
			</svg>
		</button>
		<div class="graph-carousel-slides" data-graph-carousel-slides>
			<slot />
		</div>
		<button
			type="button"
			class="graph-carousel-button"
			style="right: 10px"
			data-graph-carousel-next
			aria-label="Next"
		>
			<svg
				viewBox="0 0 1024 1024"
				version="1.1"
				xmlns="http://www.w3.org/2000/svg"
				width="100%"
				height="100%"
				aria-hidden="true"
			>
				<path
					d="M460.8 1006.933333h-375.466667c-6.826667 0-13.653333-3.413333-17.066666-10.24s0-13.653333 3.413333-17.066666L539.306667 512 71.68 47.786667C68.266667 40.96 68.266667 34.133333 68.266667 27.306667s10.24-10.24 17.066666-10.24h375.466667c3.413333 0 10.24 3.413333 13.653333 3.413333l477.866667 477.866667c6.826667 6.826667 6.826667 17.066667 0 23.893333l-477.866667 477.866667c-3.413333-3.413333-10.24 6.826667-13.653333 6.826666z m-334.506667-34.133333h327.68L914.773333 512 453.973333 51.2H126.293333l447.146667 447.146667c6.826667 6.826667 6.826667 17.066667 0 23.893333L126.293333 972.8z"
				></path>
			</svg>
		</button>
		<div class="graph-carousel-indicators" data-graph-carousel-indicators></div>
	</div>
</div>

<script>
	function initCarousel(root: HTMLElement) {
		const slidesHost = root.querySelector<HTMLElement>('[data-graph-carousel-slides]')
		if (!slidesHost) return

		const children = Array.from(slidesHost.children) as HTMLElement[]
		if (children.length === 0) return

		children.forEach((child, index) => {
			child.classList.toggle('is-active', index === 0)
		})
		root.setAttribute('data-ready', '')

		const indicators = root.querySelector<HTMLElement>('[data-graph-carousel-indicators]')
		if (indicators) {
			indicators.innerHTML = children
				.map(
					(_, index) =>
						`<button type="button" class="graph-carousel-indicator${
							index === 0 ? ' is-current' : ''
						}" data-index="${index}" aria-label="Go to slide ${index + 1}"></button>`,
				)
				.join('')
		}

		let current = 0
		const total = children.length

		const setCurrent = (next: number) => {
			children[current]?.classList.remove('is-active')
			indicators?.children[current]?.classList.remove('is-current')
			current = (next + total) % total
			children[current]?.classList.add('is-active')
			indicators?.children[current]?.classList.add('is-current')
		}

		root.querySelector('[data-graph-carousel-prev]')?.addEventListener('click', () => {
			setCurrent(current - 1)
		})
		root.querySelector('[data-graph-carousel-next]')?.addEventListener('click', () => {
			setCurrent(current + 1)
		})
		indicators?.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null
			const button = target?.closest<HTMLElement>('.graph-carousel-indicator')
			if (!button) return
			const index = Number(button.dataset.index)
			if (!Number.isNaN(index)) setCurrent(index)
		})
	}

	document.querySelectorAll<HTMLElement>('[data-graph-carousel]').forEach(initCarousel)
</script>
